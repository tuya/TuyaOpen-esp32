dependencies:
  # esp_wifi_remote / esp_hosted are only needed when the host MCU has no
  # built-in Wi-Fi/BT and must talk to a co-processor (e.g. ESP32-P4 + C6).
  # On v5.4 esp_wifi has no remote implementation, so the external component
  # is required.
  espressif/esp_wifi_remote:
    version: "==0.14.5"
    rules:
      - if: "target == esp32p4"
  espressif/esp_hosted:
    version: "==1.4.7"
    rules:
      - if: "target == esp32p4"
  waveshare/esp_lcd_sh8601: "==1.0.2"
  espressif/esp-sr: "==2.4.6"
  espressif/esp_codec_dev: "==1.3.6"
  espressif/esp_io_expander_tca9554: "==2.0.0"
  espressif/esp_lcd_panel_io_additions: "==1.0.1"
  espressif/esp_lcd_touch_ft5x06: "==1.0.7"
  espressif/esp_lcd_touch_gt911: "==1.2.0"
  espressif/esp_lcd_touch_gt1151: ">=1.1.0"
  # ST7701 MIPI-DSI panel driver — ESP32-P4 only (MIPI-DSI is P4-exclusive).
  # Other targets (esp32, esp32s3, ...) have no matching version, so gate it.
  espressif/esp_lcd_st7701:
    version: "==2.0.2"
    rules:
      - if: "target == esp32p4"
  # esp_video provides the V4L2 MIPI-CSI camera interface (P4 only).
  espressif/esp_video:
    version: "==0.8.0"
    rules:
      - if: "target == esp32p4"
  # DVP camera (ESP32 / ESP32-S3).
  espressif/esp32-camera:
    version: "==2.1.7"
    rules:
      - if: "target in [esp32, esp32s3]"
